# ============================================================================
# Static & Dynamic Analysis Targets
# ============================================================================
# These targets help check for memory leaks, security issues, and bugs.
#
# QUICK START:
#   make asan    # Build with AddressSanitizer (memory leak/overflow detection)
#   make tsan    # Build with ThreadSanitizer (race condition detection)
#   make valgrind # Run under Valgrind (detailed leak analysis)
#   make tidy    # Run clang-tidy (static analysis)
#
# ============================================================================

# Sanitizer flags
ASAN_FLAGS = -fsanitize=address -fno-omit-frame-pointer -g -O1
TSAN_FLAGS = -fsanitize=thread -g -O1
UBSAN_FLAGS = -fsanitize=undefined -g -O1

# Sanitizer binaries
TARGET_ASAN = msg_client_asan
TARGET_TSAN = msg_client_tsan
TARGET_UBSAN = msg_client_ubsan

# Source files (same as main Makefile)
CLIENT_SRCS = main.cpp msg_client.cpp log_msg.cpp config_parser.cpp

# AddressSanitizer - Memory leaks, buffer overflows, use-after-free
asan:
	@echo "Building with AddressSanitizer..."
	$(CXX) -std=c++14 -faligned-new $(ASAN_FLAGS) -Wall -Wextra -pthread -I. \
		$(CLIENT_SRCS) -o $(TARGET_ASAN) -pthread
	@echo "Run with: ./$(TARGET_ASAN) [options]"
	@echo "ASAN_OPTIONS=detect_leaks=1 ./$(TARGET_ASAN)"  

# ThreadSanitizer - Data races
# Note: TSan and ASan cannot be combined
tsan:
	@echo "Building with ThreadSanitizer..."
	$(CXX) -std=c++14 -faligned-new $(TSAN_FLAGS) -Wall -Wextra -pthread -I. \
		$(CLIENT_SRCS) -o $(TARGET_TSAN) -pthread
	@echo "Run with: ./$(TARGET_TSAN) [options]"

# UndefinedBehaviorSanitizer - Signed overflow, etc.
ubsan:
	@echo "Building with UndefinedBehaviorSanitizer..."
	$(CXX) -std=c++14 -faligned-new $(UBSAN_FLAGS) -Wall -Wextra -pthread -I. \
		$(CLIENT_SRCS) -o $(TARGET_UBSAN) -pthread
	@echo "Run with: ./$(TARGET_UBSAN) [options]"

# Valgrind - Memory leak detection (run on normal binary)
valgrind: msg_client
	@echo "Running under Valgrind (press Ctrl+C to stop)..."
	valgrind --leak-check=full \
		--show-leak-kinds=all \
		--track-origins=yes \
		--log-file=valgrind.log \
		./msg_client --host 127.0.0.1 --port 8888 || true
	@echo "Log saved to valgrind.log"

# clang-tidy - Static analysis with modern C++ checks
tidy:
	@echo "Running clang-tidy..."
	clang-tidy $(CLIENT_SRCS) -- \
		-std=c++14 -I. -D__linux__ 2>&1 | tee clang-tidy.log

# scan-build - Clang static analyzer
scan:
	@echo "Running Clang Static Analyzer..."
	scan-build --use-analyzer=/usr/bin/clang \
		-o scan-results \
		make clean msg_client 2>&1 | tee scan-build.log
	@echo "Report saved to scan-results/"

# Run all checks (quick)
check-all: check tidy
	@echo "All static checks completed"

# Clean sanitizer binaries
clean-analysis:
	rm -f $(TARGET_ASAN) $(TARGET_TSAN) $(TARGET_UBSAN)
	rm -f valgrind.log clang-tidy.log scan-build.log
	rm -rf scan-results/

.PHONY: asan tsan ubsan valgrind tidy scan check-all clean-analysis
